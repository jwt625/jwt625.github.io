                        "local_path": "media/20260728_155026_2.jpg"
                    },
                    {
                        "url": "https://pbs.twimg.com/media/HOU3QHdacAAqTOS?format=jpg",
                        "local_path": "media/20260728_155026_3.jpg"
                    }
                ],
                "timestamp": "2026-07-28T15:50:26+00:00"
            },
