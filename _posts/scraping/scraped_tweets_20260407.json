                        "url": "https://pbs.twimg.com/media/HE4lgFCbwAEXTDx?format=png",
                        "local_path": "media/20260402_081233_0.jpg"
                    }
                ],
                "timestamp": "2026-04-02T08:12:33+00:00"
            }
        ]
